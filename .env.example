# ============ 飞书应用凭证 (开放平台 > 应用信息 / 凭证) ============
TEAMO_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxx
TEAMO_FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook 校验 token 和加密 key —— 用 poll worker 模式可留空
TEAMO_FEISHU_VERIFICATION_TOKEN=
TEAMO_FEISHU_ENCRYPT_KEY=

TEAMO_FEISHU_API_BASE=https://open.feishu.cn

# ============ 触发与回复 ============
# 群 chat_id 白名单。bot 进群后用 lark-cli 或 OpenAPI /im/v1/chats 列出。
TEAMO_FEISHU_ALLOWED_CHAT_IDS=oc_replace_with_chat_id
# 在群里 @ 时识别的 bot 显示名（必须跟开放平台后台一致）。
# 改名期间可同时配多个，逗号分隔。含空格时整体加引号。
TEAMO_FEISHU_BOT_NAMES="工单助手"
# 收到工单后给提问者回一条"已记录"反馈
TEAMO_FEISHU_REPLY_ENABLED=true
# 默认负责人 open_id（必须是当前应用视角下的有效用户）
TEAMO_FEISHU_DEFAULT_ASSIGNEE_ID=ou_replace_with_owner_open_id
TEAMO_FEISHU_DEFAULT_SOURCE=内部反馈
# 用本通路时建议改成 待分解（要跟 Bitable 状态字段选项严格一致）
TEAMO_FEISHU_DEFAULT_STATUS=待分解

# ============ 自动识别规则 ============
# 文本里命中即写入"优先级"字段。允许的优先级值
TEAMO_FEISHU_PRIORITY_VALUES=P0,P1,P2,P3
# 单词边界匹配 → "前后端"多选字段。
# 必须跟 Bitable 该字段的选项严格对齐，否则飞书会拒绝写入。
TEAMO_FEISHU_SURFACE_VALUES=web,cli,server
# 模块识别：{模块名: [别名,别名]}。子串匹配（中文友好）。
# 模块名必须跟 Bitable "所属模块"字段的选项一致。
TEAMO_FEISHU_MODULE_ALIASES_JSON={"模块A":["关键词1","关键词2"],"模块B":["关键词3"]}

# ============ Bitable 目标（默认表）============
# app_token：从 Bitable URL 取 /base/<token>，或 wiki 下挂的 Bitable 需先用
# /open-apis/wiki/v2/spaces/get_node 把 wiki_token 解成 obj_token
TEAMO_FEISHU_BASE_APP_TOKEN=replace_with_app_token
TEAMO_FEISHU_BASE_TABLE_ID=tbl_replace_with_table_id

# Bitable 字段 ID
# 推荐：跑 scripts/setup_bitable.sh <APP_TOKEN> 自动建表 + 自动产出下面这些 ID
# 手动拿法：lark-cli base +field-list --base-token $APP_TOKEN --table-id $TABLE_ID
TEAMO_FEISHU_BASE_DESCRIPTION_FIELD_ID=fld_description
TEAMO_FEISHU_BASE_ATTACHMENT_FIELD_ID=fld_attachment
TEAMO_FEISHU_BASE_PRIORITY_FIELD_ID=fld_priority
TEAMO_FEISHU_BASE_STATUS_FIELD_ID=fld_status
TEAMO_FEISHU_BASE_MODULE_FIELD_ID=fld_module
TEAMO_FEISHU_BASE_SURFACE_FIELD_ID=fld_surface
TEAMO_FEISHU_BASE_ASSIGNEE_FIELD_ID=fld_assignee
TEAMO_FEISHU_BASE_REPORTER_FIELD_ID=fld_reporter
TEAMO_FEISHU_BASE_SOURCE_FIELD_ID=fld_source

# 扩展字段（用于 飞书 → 人工分解 → GitHub Issue 通路）
# 提出人 open_id：用于 GitHub Issue body 注明来源，方便 grep 反查
TEAMO_FEISHU_BASE_REPORTER_OPEN_ID_FIELD_ID=fld_reporter_open_id
# 群名：展示用，方便人工分解时看上下文
TEAMO_FEISHU_BASE_CHAT_NAME_FIELD_ID=fld_chat_name
# 飞书消息 link：一键跳回原消息
TEAMO_FEISHU_BASE_MESSAGE_LINK_FIELD_ID=fld_message_link
# 目标 Repo：人工分解时填 owner/repo
TEAMO_FEISHU_BASE_TARGET_REPO_FIELD_ID=fld_target_repo
# 子任务：人工分解，一行一个 issue title
TEAMO_FEISHU_BASE_SUBTASKS_FIELD_ID=fld_subtasks
# 分解人：人员字段
TEAMO_FEISHU_BASE_BREAKDOWN_BY_FIELD_ID=fld_breakdown_by
# GitHub Issue URLs：sync 脚本回写
TEAMO_FEISHU_BASE_GITHUB_ISSUES_FIELD_ID=fld_github_issues

# ============ 多群路由（可选）============
# 当一个机器人服务多个群、不同群写不同 sheet 时配置。
# 没在路由里的群走默认 BASE_APP_TOKEN/BASE_TABLE_ID。
# 每条路由可单独 override surfaces（去除该群不存在的选项）。
# 示例：
# TEAMO_FEISHU_CHAT_ROUTES_JSON={"oc_chat_a":{"app_token":"...","table_id":"...","surfaces":["web","server"]}}
TEAMO_FEISHU_CHAT_ROUTES_JSON=
